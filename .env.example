PORT=4000

# Supabase Postgres connection string (Dashboard → Database → Connection string → URI)
# Schema/seed SQL lives in ./supabase/ — run in Supabase SQL Editor
CONNECTION_STRING=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Auth (Dashboard → Settings → API)
# Use Project URL without /rest/v1/ and the anon public key (eyJ...)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
